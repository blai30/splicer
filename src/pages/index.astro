---
import { assetPath } from '@/lib/paths'
import Layout from '@/layouts/Layout.astro'
import { KeyboardShortcutsInit } from '@/components/KeyboardShortcutsInit'
import { ModeTabs } from '@/components/ModeTabs'
import { EditorSurface } from '@/components/EditorSurface'
import { ExportPanel } from '@/components/ExportPanel'
import { ExportHistory } from '@/components/ExportHistory'
import { LogPanel } from '@/components/LogPanel'
import '@/styles/global.css'

const pageTitle = 'Splicer | Fast Browser Video Trimmer'
const pageDescription =
  'Cut and export short video clips entirely in your browser with WebCodecs. No account and no upload required.'
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={assetPath('splash/hero-social.png')}
>
  <main
    class="mx-auto flex h-full w-full flex-col gap-3 px-3 py-3 md:px-4 md:py-4"
    role="application"
    aria-label="Video timeline editor and exporter application"
  >
    <KeyboardShortcutsInit client:only="preact" />
    <ModeTabs client:only="preact" />
    <EditorSurface client:only="preact" />
    <section aria-label="Export settings and controls">
      <ExportPanel client:only="preact" />
    </section>
    <section aria-label="Export history and downloads">
      <ExportHistory client:only="preact" />
    </section>
    <section aria-label="Logs">
      <LogPanel client:only="preact" />
    </section>
  </main>
</Layout>
